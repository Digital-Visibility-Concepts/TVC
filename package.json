{
  "name": "tvc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "postbuild": "react-snap",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/about",
      "/psychiatric",
      "/medical-weight-loss",
      "/iv-hydration",
      "/tms-therapy",
      "/telehealth",
      "/insurance",
      "/financing",
      "/contact",
      "/privacy-policy",
      "/terms-of-use",
      "/patient-information"
    ],
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "skipThirdPartyRequests": true,
    "waitFor": 800
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "react-snap": "^1.23.0",
    "vite": "^8.0.4"
  },
  "description": "",
  "main": "index.js",
  "keywords": [],
