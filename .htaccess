<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force non-www in ONE redirect. A page path without a slash gets its trailing slash in the same hop
  # (the final address is https + no www + trailing slash), so www/about does not need a second redirect.
  RewriteCond %{HTTP_HOST} ^www\.trivalleyclinic\.com$ [NC]
  RewriteRule ^([^.]*[^/.])$ https://trivalleyclinic.com/$1/ [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.trivalleyclinic\.com$ [NC]
  RewriteRule ^(.*)$ https://trivalleyclinic.com/$1 [L,R=301]

  # /home was never a page: send it to the homepage (permanent)
  RewriteRule ^home/?$ https://trivalleyclinic.com/ [R=301,L]

  # Old / planned URLs -> the real pages (permanent). Absolute https like the www rule above.
  RewriteRule ^psychiatry/?$ https://trivalleyclinic.com/psychiatric/ [R=301,L]
  RewriteRule ^weight-loss/?$ https://trivalleyclinic.com/medical-weight-loss/ [R=301,L]
  RewriteRule ^tms-therapy/?$ https://trivalleyclinic.com/tms/ [R=301,L]

  # Let WordPress handle /blog and /wordpress
  RewriteCond %{REQUEST_URI} ^/blog [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_URI} ^/wordpress [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>
# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit